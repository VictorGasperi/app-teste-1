# Required, always. One of: test | dev | homol | prod
# `test` binds every port to its in-memory mock, so the unit suite needs no
# other variable in this file.
STAGE=

# Required: dev, homol, prod. Unused in test (mocks).
# Postgres connection string used by the `pg` driver.
DATABASE_URL=

# Public base URL of this app, used to build absolute callback URLs.
# Local development: http://localhost:3000
APP_BASE_URL=
